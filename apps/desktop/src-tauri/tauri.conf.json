{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azeroth Navigator",
  "version": "0.2.0",
  "identifier": "io.github.laymer.azeroth-navigator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Azeroth Navigator", "width": 1100, "height": 760, "minWidth": 640, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' atlas: http://atlas.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
