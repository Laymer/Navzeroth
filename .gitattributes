# Contract artifacts are compared byte for byte across Linux and Windows.
schemas/** text eol=lf
fixtures/** text eol=lf

# Binary imagery; owner-supplied files under content/forever are LFS-tracked (see content/forever/atlas/NOTICE).
# Synthetic demo imagery under content/demo stays a plain blob so CI can decode it.
# Content records are hashed byte for byte; keep LF on every platform.
content/**/*.json text eol=lf
content/**/NOTICE text eol=lf
# Authored procedures and evidence are pinned by SHA-256 in party-support.json.
content/authored/**/*.md text eol=lf
*.png binary
content/forever/**/*.png filter=lfs diff=lfs merge=lfs -text

# Exact licensed source snapshots; never normalize their hashed bytes.
content/source-materials/objects/* -text
crates/local-data/vendor/** -text -whitespace
vendor/** -text -whitespace
crates/local-data/notices/** -text -whitespace

# Generator fingerprints and source policies are platform-independent bytes.
*.rs text eol=lf
Cargo.lock text eol=lf
**/Cargo.toml text eol=lf
docs/sources/source-admission-v1.json text eol=lf
docs/sources/source-updates-v1.json text eol=lf

# Lua and SQL are hashed or byte-compared by tests; keep LF on every platform.
*.lua text eol=lf
*.sql text eol=lf

# Bundled fonts and their OFL notices ship and are hashed byte for byte (apps/desktop/THIRD_PARTY.md).
apps/desktop/src/theme/fonts/* -text
apps/desktop/THIRD_PARTY.md text eol=lf

# Retained upstream notice inputs are hashed before packaging; preserve original bytes.
config/dependency-notices/** -text -whitespace
config/dependency-notice-overrides.json text eol=lf
pnpm-lock.yaml text eol=lf
